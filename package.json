{
  "name": "maintainer-ai",
  "version": "0.1.0",
  "private": false,
  "description": "AI-powered GitHub repository management and automation platform for open-source maintainers",
  "license": "MIT",
  "author": "MaintainerAI Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imuniqueshiv/MaintainerAI.git"
  },
  "bugs": {
    "url": "https://github.com/imuniqueshiv/MaintainerAI/issues"
  },
  "homepage": "https://github.com/imuniqueshiv/MaintainerAI#readme",
  "keywords": [
    "maintainerai",
    "github",
    "open-source",
    "maintainer",
    "automation",
    "ai",
    "nextjs",
    "devtools"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:validate": "prisma validate",
    "infra:check": "tsx --tsconfig tsconfig.json scripts/check-infra.ts",
    "worker": "tsx --tsconfig tsconfig.json scripts/worker.ts",
    "labels:sync": "node scripts/sync-labels.mjs",
    "prepare": "husky || true"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.5.0",
    "@prisma/client": "^6.19.0",
    "@vercel/analytics": "1.6.1",
    "bullmq": "^5.81.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.28.0",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5",
    "prettier": "^3.5.3",
    "prisma": "6.19.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "5.7.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    }
  }
}
