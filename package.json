{
  "name": "maintainer-ai",
  "version": "0.1.0",
  "private": false,
  "description": "AI-powered GitHub repository management and automation platform for open-source maintainers",
  "license": "MIT",
  "author": "MaintainerAI Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imuniqueshiv/MaintainerAI.git"
  },
  "bugs": {
    "url": "https://github.com/imuniqueshiv/MaintainerAI/issues"
  },
  "homepage": "https://github.com/imuniqueshiv/MaintainerAI#readme",
  "keywords": [
    "maintainerai",
    "github",
    "open-source",
    "maintainer",
    "automation",
    "ai",
    "nextjs",
    "devtools"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "labels:sync": "node scripts/sync-labels.mjs",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.3.2",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    }
  }
}
