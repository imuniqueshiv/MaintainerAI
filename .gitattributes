# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.xml text eol=lf
*.sh text eol=lf
*.env text eol=lf
*.example text eol=lf

# Denote binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary

# Lockfiles — keep diffs readable but don't reformat
pnpm-lock.yaml text eol=lf linguist-generated=true

# Docker
Dockerfile text eol=lf
.dockerignore text eol=lf
