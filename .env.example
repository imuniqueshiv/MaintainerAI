# MaintainerAI environment variables
# Copy for local development:
#   cp .env.example .env.local
#
# For Docker Compose infrastructure (recommended for Phase 1+):
#   cp .env.example .env
#
# Never commit real secrets. See docs/configuration.md.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
LOG_LEVEL=info
# LOG_PRETTY=true

# -----------------------------------------------------------------------------
# Infrastructure (Phase 1) — required for /api/ready and worker
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://maintainerai:maintainerai@localhost:5433/maintainerai?schema=public
REDIS_URL=redis://localhost:6380
QUEUE_PREFIX=maintainerai
WORKER_CONCURRENCY=5

# Set true to fail startup when DATABASE_URL/REDIS_URL are missing
INFRASTRUCTURE_STRICT=false
# SKIP_ENV_VALIDATION=1

# -----------------------------------------------------------------------------
# Security / HTTP
# -----------------------------------------------------------------------------
CORS_ORIGIN=*
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# -----------------------------------------------------------------------------
# GitHub OAuth / Auth.js (Phase 2)
# -----------------------------------------------------------------------------
# Create a GitHub OAuth App: https://github.com/settings/developers
# Authorization callback URL: {NEXTAUTH_URL}/api/auth/callback/github
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# AUTH_SECRET=                 # optional alias for NEXTAUTH_SECRET
# AUTH_STRICT=false            # fail startup when OAuth secrets missing
# AUTH_SESSION_MAX_AGE_SECONDS=2592000
# AUTH_SESSION_UPDATE_AGE_SECONDS=86400
# AUTH_CSRF_PROTECT=false      # true in production by default via config

# -----------------------------------------------------------------------------
# GitHub App (Phase 3)
# -----------------------------------------------------------------------------
# Create a GitHub App: see GITHUB_APP_SETUP.md
# Setup URL / callback: {NEXT_PUBLIC_APP_URL}/api/v1/auth/github/callback
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/webhooks/github
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM private key. Prefer a single line with \n escapes, or a multiline quoted value.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=maintainerai
# GITHUB_APP_STRICT=false
# Process webhooks in the web process (skip BullMQ). Prefer a worker in production.
# GITHUB_WEBHOOK_INLINE=false

# -----------------------------------------------------------------------------
# AI Providers (Phase 5 — unused in Phase 3)
# -----------------------------------------------------------------------------
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=

# -----------------------------------------------------------------------------
# Object storage (future)
# -----------------------------------------------------------------------------
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Observability (Phase 8 — unused in Phase 1)
# -----------------------------------------------------------------------------
# SENTRY_DSN=
